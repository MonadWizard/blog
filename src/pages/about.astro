---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const skills = [
  {
    category: 'Languages & Frameworks',
    items: ['Python', 'Django', 'FastAPI', 'Django REST Framework', 'REST APIs', 'GraphQL'],
  },
  {
    category: 'Databases & Search',
    items: ['PostgreSQL', 'Redis', 'Elasticsearch', 'SQLite', 'Elasticsearch DBA'],
  },
  {
    category: 'Infrastructure & DevOps',
    items: ['Nginx', 'Docker', 'Linux', 'GitHub Actions', 'CI/CD', 'Server Security'],
  },
  {
    category: 'Architecture Patterns',
    items: ['Microservices', 'Event-Driven', 'Data Pipelines', 'Caching Strategies', 'Full-Text Search'],
  },
];

const experience = [
  {
    company: 'Algorithm Generation',
    meta: 'Full-time',
    roles: [
      {
        title: 'Product Developer',
        period: 'Feb 2026 — Present',
        location: 'Spordium, Banani, Dhaka, Bangladesh · On-site',
        description: 'Python Backend, PostgreSQL, PL/pgSQL, DevOps, System Design',
        skills: ['DevOps', 'PostgreSQL'],
      },
      {
        title: 'Senior Software Developer',
        period: 'Mar 2024 — Mar 2025 · 1 yr 1 mo',
        location: 'Gulshan, Dhaka, Bangladesh · On-site',
        skills: ['Software Systems Engineering', 'Django REST Framework'],
      },
      {
        title: 'Software Developer',
        period: 'Aug 2023 — Mar 2024 · 8 mos',
        location: 'Gulshan, Dhaka, Bangladesh · On-site',
        skills: ['Nginx', 'Amazon Web Services (AWS)'],
      },
      {
        title: 'Junior Developer',
        period: 'Aug 2022 — Sep 2023 · 1 yr 2 mos',
        location: 'Gulshan, Dhaka, Bangladesh',
        skills: ['Nginx', 'PostgreSQL'],
      },
      {
        title: 'Apprenticeship',
        period: 'Dec 2021 — Aug 2022 · 9 mos',
        skills: ['Analytical Skills'],
      },
    ],
  },
];

const education = [
  {
    school: 'Daffodil International University (DIU)',
    degree: 'Bachelor of Science (BS), Computer Science',
    period: '2015 — 2020',
  },
];

const certifications = [
  { name: 'Problem Solving (Basic)', issuer: 'HackerRank', issued: 'Sep 2020', id: '7A27AEDDD38F' },
  { name: 'Python (Advanced)', issuer: 'HackerRank', issued: 'Sep 2020', id: 'C4DF624AD9F0' },
  { name: 'Python (Intermediate)', issuer: 'HackerRank', issued: 'Sep 2020', id: 'A75E66C5049F' },
];
---

<BaseLayout
  title="About — Rakib Hasan"
  description="Backend Software Developer & System Architect based in Dhaka, Bangladesh. Specializing in Django, FastAPI, PostgreSQL, Redis, and Elasticsearch."
>
  <Navbar />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <!-- Profile section -->
    <section class="mb-16 pb-16 border-b border-gray-100 dark:border-gray-800">
      <div class="flex flex-col sm:flex-row gap-8 items-start">
        <!-- Avatar placeholder -->
        <div class="flex-shrink-0 w-24 h-24 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white text-3xl font-bold select-none">
          R
        </div>

        <div class="flex-1">
          <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-1">Rakib Hasan</h1>
          <p class="text-indigo-600 dark:text-indigo-400 font-medium mb-1">Backend Software Developer & System Architect</p>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
            <svg class="inline w-4 h-4 mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
            </svg>
            Dhaka, Bangladesh
          </p>
          <p class="text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl">
            I specialize in building highly scalable RESTful services and robust backend infrastructure.
            My core stack includes <strong class="text-gray-800 dark:text-gray-200">Django, FastAPI, and Python</strong>.
            I design complex data pipelines connecting <strong class="text-gray-800 dark:text-gray-200">PostgreSQL, Redis, and Elasticsearch</strong>,
            and I am currently advancing my expertise in Elasticsearch Database Administration (DBA).
            I am meticulous about server security, specifically configuring
            <strong class="text-gray-800 dark:text-gray-200">Nginx deployments</strong> to strictly serve assigned domains
            and reject catch-all traffic.
          </p>

          <!-- Resume download -->
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={`${import.meta.env.BASE_URL}resume.pdf`}
              download
              class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg transition-colors"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
              </svg>
              Download Resume
            </a>
            <a
              href="https://github.com/MonadWizard"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg transition-colors"
            >
              GitHub
            </a>
            <a
              href="https://www.linkedin.com/in/rakib-hasan-90518b140/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-lg transition-colors"
            >
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section class="mb-16">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-8">Technical Skills</h2>
      <div class="grid sm:grid-cols-2 gap-8">
        {skills.map((group) => (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-3">
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.items.map((skill) => (
                <span class="inline-flex items-center px-3 py-1 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 text-sm font-medium rounded-full border border-gray-200 dark:border-gray-700 hover:border-indigo-400 dark:hover:border-indigo-500 transition-colors">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="mb-16">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-8">Experience</h2>
      <div class="space-y-10">
        {experience.map((org) => (
          <div>
            <div class="mb-4">
              <h3 class="font-semibold text-gray-900 dark:text-white">{org.company}</h3>
              <p class="text-xs text-gray-400 dark:text-gray-500">{org.meta}</p>
            </div>
            <ol class="relative border-l border-gray-200 dark:border-gray-700 ml-1 space-y-6">
              {org.roles.map((role) => (
                <li class="pl-6 relative">
                  <span class="absolute -left-[5px] top-1.5 w-2.5 h-2.5 rounded-full bg-indigo-500 ring-4 ring-indigo-100 dark:ring-indigo-900/40"></span>
                  <h4 class="font-medium text-indigo-600 dark:text-indigo-400">{role.title}</h4>
                  <p class="text-xs text-gray-400 dark:text-gray-500">{role.period}</p>
                  {role.location && (
                    <p class="text-xs text-gray-400 dark:text-gray-500">{role.location}</p>
                  )}
                  <div class="mb-2"></div>
                  {role.description && (
                    <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-2">{role.description}</p>
                  )}
                  <div class="flex flex-wrap gap-1.5">
                    {role.skills.map((skill) => (
                      <span class="px-2 py-0.5 text-xs bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 rounded-full border border-gray-200 dark:border-gray-700">
                        {skill}
                      </span>
                    ))}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="mb-16">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-8">Education</h2>
      <div class="space-y-6">
        {education.map((edu) => (
          <div>
            <h3 class="font-semibold text-gray-900 dark:text-white">{edu.school}</h3>
            <p class="text-sm text-indigo-600 dark:text-indigo-400 font-medium">{edu.degree}</p>
            <p class="text-xs text-gray-400 dark:text-gray-500">{edu.period}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Certifications -->
    <section class="mb-16">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-8">Licenses &amp; Certifications</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        {certifications.map((cert) => (
          <a
            href={`https://www.hackerrank.com/certificates/${cert.id.toLowerCase()}`}
            target="_blank"
            rel="noopener noreferrer"
            class="block p-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:border-indigo-400 dark:hover:border-indigo-500 transition-colors"
          >
            <h3 class="font-semibold text-gray-900 dark:text-white text-sm">{cert.name}</h3>
            <p class="text-sm text-indigo-600 dark:text-indigo-400">{cert.issuer}</p>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">Issued {cert.issued}</p>
            <p class="text-xs text-gray-400 dark:text-gray-500 font-mono">ID {cert.id}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Workspace -->
    <section>
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">Workspace</h2>
      <div class="p-6 bg-gray-50 dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-700">
        <div class="grid sm:grid-cols-2 gap-4 text-sm">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-1">GPU</p>
            <p class="text-gray-700 dark:text-gray-300 font-medium">Intel Arc A770</p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-1">CPU</p>
            <p class="text-gray-700 dark:text-gray-300 font-medium">AMD Ryzen 7 7700</p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-1">OS</p>
            <p class="text-gray-700 dark:text-gray-300 font-medium">Linux</p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-1">Editor</p>
            <p class="text-gray-700 dark:text-gray-300 font-medium">VS Code + Claude Code</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>
