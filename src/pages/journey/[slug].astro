---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import JourneyStep from '../../components/JourneyStep.astro';
import JourneyFloatingNav from '../../components/JourneyFloatingNav.astro';

export async function getStaticPaths() {
  const journeys = await getCollection('journey', ({ data }) => !data.draft);
  return journeys.map((journey) => ({
    params: { slug: journey.id },
    props: { journey },
  }));
}

const { journey } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage, steps } = journey.data;

// Pre-generated per-step TTS audio (if any) — see scripts/generate_audio.py.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let audioManifest: Record<string, { file?: string; segmentsFile?: string }> = {};
try {
  audioManifest = JSON.parse(fs.readFileSync(path.resolve('public/audio/manifest.json'), 'utf8'));
} catch {
  // no manifest yet — players simply won't render
}

// Render step descriptions from markdown at build time + attach each step's audio
const stepsWithHtml = steps.map((step, i) => {
  const parts = step.levelPath.split('.');
  const depth = parseInt(parts[0], 10);
  const entry = audioManifest[`jstep:${journey.id}:${i}`];
  return {
    ...step,
    depth,
    stepIndex: i,
    descriptionHtml: marked.parse(step.description ?? '') as string,
    audioSrc: entry?.file ? base + '/' + entry.file : undefined,
    audioData: entry?.segmentsFile ? base + '/' + entry.segmentsFile : undefined,
  };
});

const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const updatedFormatted = updatedDate?.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout title={`${title} — With Journey`} description={description} ogImage={heroImage}>
  <Navbar />
  <JourneyFloatingNav steps={steps} slug={journey.id} />

  <main id="journey-content" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <!-- Hero header -->
    <header class="mb-10">
      {heroImage && (
        <img
          src={heroImage}
          alt=""
          class="w-full h-48 object-cover rounded-xl mb-8 opacity-90"
          loading="eager"
        />
      )}

      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => (
          <a
            href={`${import.meta.env.BASE_URL}journey?tags=${encodeURIComponent(tag)}`}
            class="inline-block text-xs px-2.5 py-0.5 bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-400 rounded-full font-medium border border-indigo-200 dark:border-indigo-800 hover:bg-indigo-100 dark:hover:bg-indigo-900 transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>

      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-3 leading-tight">
        {title}
      </h1>
      <p class="text-lg text-gray-500 dark:text-gray-400 mb-4 leading-relaxed">
        {description}
      </p>

      <div class="flex items-center gap-3 text-sm text-gray-400 dark:text-gray-500">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span>Updated {updatedFormatted}</span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{steps.length} {steps.length === 1 ? 'step' : 'steps'}</span>
      </div>
    </header>

    <!-- Resume last position -->
    <div class="journey-resume-banner hidden mb-8 flex flex-wrap items-center justify-between gap-3 p-4 rounded-xl border border-indigo-200 dark:border-indigo-800 bg-indigo-50 dark:bg-indigo-950/40">
      <p class="text-sm text-gray-600 dark:text-gray-300">
        Continue where you left off: <span class="journey-resume-title font-medium text-gray-900 dark:text-white"></span>
      </p>
      <a href="#" class="journey-resume-link shrink-0 inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">
        Resume <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Step cards -->
    {steps.length > 0 && (
      <section>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">Steps</h2>
        <div>
          {stepsWithHtml.map((step) => (
            <JourneyStep
              levelPath={step.levelPath}
              levelTitle={step.levelTitle}
              title={step.title}
              descriptionHtml={step.descriptionHtml}
              depth={step.depth}
              markers={step.markers}
              stepIndex={step.stepIndex}
              audioSrc={step.audioSrc}
              audioData={step.audioData}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Back link -->
    <div class="mt-16 pt-8 border-t border-gray-100 dark:border-gray-800">
      <a
        href={`${import.meta.env.BASE_URL}journey`}
        class="inline-flex items-center gap-2 text-sm text-indigo-600 dark:text-indigo-400 hover:text-indigo-800 dark:hover:text-indigo-300 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        All Journeys
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
